# Throwaway credentials for the temporary MariaDB container started by the
# Makefile. Copied into tmp/service/, which is searched before
# ~/.config/SickRock/, so a developer's own env file is never used.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=sickrock
DB_PASS=sickrock-demo
DB_NAME=sickrock
JWT_SECRET=marketing-demo-not-a-secret
